genrule(
    name = "gen_asn1",
    srcs = ASN1_SOURCES,
    outs = ASN1_GENERATED_C + ASN1_GENERATED_H,
   cmd = """
  set -euo pipefail

  ROOT="$$(pwd)"
  outdir="$(@D)/generated/asn1"
  mkdir -p "$$outdir"
  cd "$$outdir"

  inputs=""
  for s in $(SRCS); do
    inputs="$$inputs $$ROOT/$$s"
  done

  asn1c -fcompound-names $$inputs
  rm -f converter-example.c converter-sample.c || true

  # Copy generated files from CWD (we are in outdir)
  for out in $(OUTS); do
    base="$$(basename "$$out")"
    mkdir -p "$$(dirname "$$out")"
    cp -f "$$base" "$$out"
  done
"""
)


cc_library(
    name = "asn1_lib",
    srcs = ASN1_GENERATED_C,
    hdrs = ASN1_GENERATED_H,
    includes = ["generated/asn1"],
    copts = [
        "-Wno-error",
        "-w",
    ],
    deps = [
        "//src/libaktualizr/utilities:utilities",
    ],
)
